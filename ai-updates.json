      "id": "copilot-1785939973614-5",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-08-05",
      "text": "Why: Visual information helps users understand complex content faster and reduces the need to switch between apps or documents.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
