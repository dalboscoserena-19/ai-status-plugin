      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1788708082293-4",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-09-06",
      "text": "Announced the deprecation of whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe, and gpt-4o-transcribe-diarize. These models will shut down on February 26, 2027. Migrate to gpt-live-transcribe or gpt-transcribe. See the transcription guide and deprecations page.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1788708082294-5",
