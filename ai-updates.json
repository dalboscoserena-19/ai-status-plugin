      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-06-03",
      "text": "Added return_token_budget for the Responses API web search tool. Use it to opt in to longer GPT-5+ reasoning web search runs for high-effort research and evaluation workloads.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
