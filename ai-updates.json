      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-04-22",
      "text": "Review the new Copilot video generation setting in the Microsoft 365 admin center.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
