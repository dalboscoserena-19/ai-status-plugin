    {
      "id": "openai-1786758114792-0",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Announced Ultrafast mode, a new API service tier for GPT-5.6 Sol that runs up to 14x faster than Standard processing. Available in limited preview to select customers. Sign up to receive updates on Ultrafast mode here.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114792-1",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Start with Daybreak Blue for most defensive security work. It provides access to general-purpose models such as GPT-5.6 Sol for vulnerability discovery, secure code review, detection engineering, incident response, malware analysis, and patch validation. Read more here.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114792-2",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Daybreak Red provides separately approved access to purpose-trained models such as GPT-5.6 Cyber for authorized vulnerability reproduction, exploit validation, penetration testing, red teaming, and complex system analysis.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114792-3",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "These models require separate approval and provisioning. You can apply to join the Daybreak program here. More details on pricing here.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114792-4",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Updated the chat-latest snapshot, which points to the latest model available in ChatGPT for Plus and Pro users. We recommend leveraging GPT-5.6 Sol for production API usage, but feel free to use this model to test the latest improvements for chat use cases. The underlying model snapshot will be regu",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114792-5",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Fast mode now supports long-context requests for GPT-5.6 Sol, GPT-5.6 Terra, and GPT-5.6 Luna. As of today, long-context prompts exceeding 272K tokens can run in Fast mode, delivering speeds up to 2.5× faster than the Standard tier. See pricing details.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114793-6",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "We're also introducing Fast mode in the API, which replaces our Priority Processing offering. For GPT-5.6 Sol, Fast mode now delivers up to 2.5× faster speeds than standard processing at twice the price. This change is backward compatible: requests tagged priority will automatically use Fast mode.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114793-7",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Released GPT Transcribe for accurate file transcription and final transcripts of committed Realtime turns, along with GPT Live Transcribe for low-latency streaming transcription.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114793-8",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Both models support free-form transcription context, keyword hints, and multiple expected input languages. Compare supported outputs and workflows in the transcription guide.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1786758114793-9",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-15",
      "text": "Released the GPT-5.6 model family, including GPT-5.6 Sol for frontier capability, GPT-5.6 Terra for a balance of intelligence and cost, and GPT-5.6 Luna for efficient, high-volume workloads. The gpt-5.6 alias routes requests to gpt-5.6-sol.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
