      "providerColor": "#0078D4",
      "date": "2026-09-12",
      "text": "Ask Copilot to complete a task like summarizing trends, cleaning data, or creating a visualization with Python.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
