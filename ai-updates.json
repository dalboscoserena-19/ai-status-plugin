      "providerColor": "#0078D4",
      "date": "2026-06-04",
      "text": "This page lists the latest features and improvements for Microsoft 365 Copilot. It includes changes that are generally available (Current Channel for Microsoft 365 apps) and specific to each platform.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
      "id": "copilot-1780567873368-1",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-06-04",
      "text": "Copilot features are introduced using a safe deployment model, gradually rolling out to a subset of users within a tenant before expanding across the organization.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
      "id": "copilot-1780567873369-2",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-06-04",
      "text": "Organizational Messages Usage‑based targeting is now generally available in the Microsoft 365 admin center! [Web]",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
      "id": "copilot-1780567873369-3",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-06-04",
      "text": "Organizational Messages now supports usage‑based targeting in addition to existing group‑based targeting capabilities. This enables admins to deliver Organizational Messages based on real user behavior and engagement patterns rather than static group membership.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
      "id": "copilot-1780567873369-4",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-06-04",
      "text": "What changed: Admins can now target Organizational Messages using dynamic usage behaviors through Usage‑based targeting. This allows IT admins to drive Microsoft 365 Copilot adoption by reaching users based on actual product usage instead of relying only on pre‑configured groups or distribution list",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
