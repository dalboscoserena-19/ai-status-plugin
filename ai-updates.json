      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-09-06",
      "text": "Why: Python is widely used for data analysis, visualization, and automation. Bringing Copilot-assisted Python editing into Excel helps users move from intent to working analysis faster without switching tools.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
