    {
      "id": "openai-1780485528040-1",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-06-03",
      "text": "Released chat-latest snapshot which points to the latest Instant model currently used in ChatGPT. We recommend leveraging GPT-5.5 for production API usage, but feel free to use this model to test the latest improvements for chat use cases. The underlying model snapshot will be regularly updated. Rea",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
