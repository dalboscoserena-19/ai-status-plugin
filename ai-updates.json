      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-08-05",
      "text": "Copilot now displays rich images from files and meetings directly within responses to improve comprehension.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
    {
      "id": "copilot-1785939973614-4",
      "provider": "copilot",
      "providerName": "Microsoft Copilot",
      "providerColor": "#0078D4",
      "date": "2026-08-05",
      "text": "What changed: Previously, Copilot responses included text only. Now, it surfaces relevant images inline from files and meetings to provide visual context. This enhancement supports richer content formats while maintaining data security and compliance with Microsoft 365 policies.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
    },
