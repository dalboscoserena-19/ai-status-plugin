    {
      "id": "openai-1785939972466-0",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "We're also introducing Fast mode in the API, which replaces our Priority Processing offering. For GPT-5.6 Sol, Fast mode now delivers up to 2.5× faster speeds than standard processing at twice the price. This change is backward compatible: requests tagged priority will automatically use Fast mode.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972467-1",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Released GPT Transcribe for accurate file transcription and final transcripts of committed Realtime turns, along with GPT Live Transcribe for low-latency streaming transcription.",
      "severity": "low",
      "severityLabel": "Miglioramento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972467-2",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Both models support free-form transcription context, keyword hints, and multiple expected input languages. Compare supported outputs and workflows in the transcription guide.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972468-3",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Released the GPT-5.6 model family, including GPT-5.6 Sol for frontier capability, GPT-5.6 Terra for a balance of intelligence and cost, and GPT-5.6 Luna for efficient, high-volume workloads. The gpt-5.6 alias routes requests to gpt-5.6-sol.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972468-4",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "GPT-5.6 adds Programmatic Tool Calling, explicit prompt caching controls, persisted reasoning, max reasoning effort, and Pro mode, and Multi-agent orchestration in beta for the Responses API. GPT-5.6 also accepts images at their original dimensions with original or auto image detail.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972468-5",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Released GPT-Realtime-2.1, an updated realtime reasoning model with improved alphanumeric recognition, silence and noise handling, and interruption behavior. Also released GPT-Realtime-2.1 mini, a faster, lower-cost distilled reasoning model for realtime voice applications.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972468-6",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Updated the chat-latest snapshot, which points to the latest Instant model currently used in ChatGPT. We recommend leveraging GPT-5.5 for production API usage, but feel free to use this model to test the latest improvements for chat use cases. The underlying model snapshot will be regularly updated.",
      "severity": "info",
      "severityLabel": "Info",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972469-7",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Released the Safety Usage Dashboard on the OpenAI API platform. The Safety dashboard shows blocked Responses requests based on safety_identifier values sent on requests to identify end users. Visit the Safety dashboard.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972469-8",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "Added moderation scores to the Responses API and Chat Completions API. Pass a moderation object in a generation request to receive moderation results for both the model input and generated output in the same response.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
    {
      "id": "openai-1785939972469-9",
      "provider": "openai",
      "providerName": "OpenAI (GPT)",
      "providerColor": "#059669",
      "date": "2026-08-05",
      "text": "OpenAI models are now available in Amazon Bedrock through an OpenAI-compatible Responses API endpoint. Supported models and features vary by AWS Region. Learn more.",
      "severity": "medium",
      "severityLabel": "Cambio comportamento",
      "source": "https://platform.openai.com/docs/changelog"
    },
